// The property from Phase 5, example 3, now expressible with "accepted" (amendment A23).
// Before A23 it compared result with the outcome "ok", which the grammar could not express.
module projects@1.0.0
principal User
enum Role { Member, Admin }
entity User { email: Text, role: Role = Member }
entity Project { owner: Id<User>, name: Text }
permission CanEdit(u: User, p: Project) = p.owner == u.id or u.role == Admin

rule RenameProject(p: Project, name: Text)
  permit CanEdit(caller, p)
  set p.name = name

property "rename succeeds exactly for owners and admins"
  forall r: Role, isOwner: Bool {
    given o = create User { email = "o@x" }
    given u = create User { email = "u@x", role = r }
    given p = create Project { owner = if isOwner then u.id else o.id, name = "Apollo" }
    when RenameProject(p, "New") as u expect any
    then accepted == (isOwner or r == Admin)
  }
