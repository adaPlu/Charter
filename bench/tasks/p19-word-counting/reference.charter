// BLOCKED: fails the "separators" scenario. It reads only passages whose characters are all in
// its table.
//
// Charter cannot index, split or slice Text, but it can compare Text in code-unit order, and a
// fn may call itself. If s starts with the known prefix p, its next character is c exactly when
// p + c <= s and s < p + c', where c' is the character right after c. So the passage is read one
// character at a time, against a table of the characters the program knows.
//
// The table cannot cover every character. String literals have no escapes beyond \n and \t, and
// nothing turns a number into a character, so each character must be written out in the source.
// This table holds tab, printable ASCII and Latin-1 (U+00A0 to U+00FF), apart from "~", whose
// successor is a control character that cannot be written. Any other character, such as "中",
// an emoji or "~", stops the reading: the words before it are counted and the rest is ignored.
// The request says every non-ASCII character separates words, so on such a passage this program
// gives a wrong count: "cat中cat cat" gives 1, not 3. A hidden test checks exactly that; the
// project owner added it on November 9, 2026, after this reference passed without it.
//
// Checking that the search term is only ASCII letters is fully correct: that alphabet is closed.
module wordcount@0.1.0

// c: a character; n: the character right after it; l: its lowercase letter, or " " for a separator.
type Ch = { c: Text, n: Text, l: Text }

fn letters(): List<Ch> = [
  { c = "A", n = "B", l = "a" }, { c = "B", n = "C", l = "b" }, { c = "C", n = "D", l = "c" }, { c = "D", n = "E", l = "d" },
  { c = "E", n = "F", l = "e" }, { c = "F", n = "G", l = "f" }, { c = "G", n = "H", l = "g" }, { c = "H", n = "I", l = "h" },
  { c = "I", n = "J", l = "i" }, { c = "J", n = "K", l = "j" }, { c = "K", n = "L", l = "k" }, { c = "L", n = "M", l = "l" },
  { c = "M", n = "N", l = "m" }, { c = "N", n = "O", l = "n" }, { c = "O", n = "P", l = "o" }, { c = "P", n = "Q", l = "p" },
  { c = "Q", n = "R", l = "q" }, { c = "R", n = "S", l = "r" }, { c = "S", n = "T", l = "s" }, { c = "T", n = "U", l = "t" },
  { c = "U", n = "V", l = "u" }, { c = "V", n = "W", l = "v" }, { c = "W", n = "X", l = "w" }, { c = "X", n = "Y", l = "x" },
  { c = "Y", n = "Z", l = "y" }, { c = "Z", n = "[", l = "z" }, { c = "a", n = "b", l = "a" }, { c = "b", n = "c", l = "b" },
  { c = "c", n = "d", l = "c" }, { c = "d", n = "e", l = "d" }, { c = "e", n = "f", l = "e" }, { c = "f", n = "g", l = "f" },
  { c = "g", n = "h", l = "g" }, { c = "h", n = "i", l = "h" }, { c = "i", n = "j", l = "i" }, { c = "j", n = "k", l = "j" },
  { c = "k", n = "l", l = "k" }, { c = "l", n = "m", l = "l" }, { c = "m", n = "n", l = "m" }, { c = "n", n = "o", l = "n" },
  { c = "o", n = "p", l = "o" }, { c = "p", n = "q", l = "p" }, { c = "q", n = "r", l = "q" }, { c = "r", n = "s", l = "r" },
  { c = "s", n = "t", l = "s" }, { c = "t", n = "u", l = "t" }, { c = "u", n = "v", l = "u" }, { c = "v", n = "w", l = "v" },
  { c = "w", n = "x", l = "w" }, { c = "x", n = "y", l = "x" }, { c = "y", n = "z", l = "y" }, { c = "z", n = "{", l = "z" }]

fn others(): List<Ch> = [
  { c = "\t", n = "\n", l = " " }, { c = " ", n = "!", l = " " }, { c = "!", n = "\"", l = " " }, { c = "\"", n = "#", l = " " },
  { c = "#", n = "$", l = " " }, { c = "$", n = "%", l = " " }, { c = "%", n = "&", l = " " }, { c = "&", n = "'", l = " " },
  { c = "'", n = "(", l = " " }, { c = "(", n = ")", l = " " }, { c = ")", n = "*", l = " " }, { c = "*", n = "+", l = " " },
  { c = "+", n = ",", l = " " }, { c = ",", n = "-", l = " " }, { c = "-", n = ".", l = " " }, { c = ".", n = "/", l = " " },
  { c = "/", n = "0", l = " " }, { c = "0", n = "1", l = " " }, { c = "1", n = "2", l = " " }, { c = "2", n = "3", l = " " },
  { c = "3", n = "4", l = " " }, { c = "4", n = "5", l = " " }, { c = "5", n = "6", l = " " }, { c = "6", n = "7", l = " " },
  { c = "7", n = "8", l = " " }, { c = "8", n = "9", l = " " }, { c = "9", n = ":", l = " " }, { c = ":", n = ";", l = " " },
  { c = ";", n = "<", l = " " }, { c = "<", n = "=", l = " " }, { c = "=", n = ">", l = " " }, { c = ">", n = "?", l = " " },
  { c = "?", n = "@", l = " " }, { c = "@", n = "A", l = " " }, { c = "[", n = "\\", l = " " }, { c = "\\", n = "]", l = " " },
  { c = "]", n = "^", l = " " }, { c = "^", n = "_", l = " " }, { c = "_", n = "`", l = " " }, { c = "`", n = "a", l = " " },
  { c = "{", n = "|", l = " " }, { c = "|", n = "}", l = " " }, { c = "}", n = "~", l = " " }, { c = " ", n = "¡", l = " " },
  { c = "¡", n = "¢", l = " " }, { c = "¢", n = "£", l = " " }, { c = "£", n = "¤", l = " " }, { c = "¤", n = "¥", l = " " },
  { c = "¥", n = "¦", l = " " }, { c = "¦", n = "§", l = " " }, { c = "§", n = "¨", l = " " }, { c = "¨", n = "©", l = " " },
  { c = "©", n = "ª", l = " " }, { c = "ª", n = "«", l = " " }, { c = "«", n = "¬", l = " " }, { c = "¬", n = "­", l = " " },
  { c = "­", n = "®", l = " " }, { c = "®", n = "¯", l = " " }, { c = "¯", n = "°", l = " " }, { c = "°", n = "±", l = " " },
  { c = "±", n = "²", l = " " }, { c = "²", n = "³", l = " " }, { c = "³", n = "´", l = " " }, { c = "´", n = "µ", l = " " },
  { c = "µ", n = "¶", l = " " }, { c = "¶", n = "·", l = " " }, { c = "·", n = "¸", l = " " }, { c = "¸", n = "¹", l = " " },
  { c = "¹", n = "º", l = " " }, { c = "º", n = "»", l = " " }, { c = "»", n = "¼", l = " " }, { c = "¼", n = "½", l = " " },
  { c = "½", n = "¾", l = " " }, { c = "¾", n = "¿", l = " " }, { c = "¿", n = "À", l = " " }, { c = "À", n = "Á", l = " " },
  { c = "Á", n = "Â", l = " " }, { c = "Â", n = "Ã", l = " " }, { c = "Ã", n = "Ä", l = " " }, { c = "Ä", n = "Å", l = " " },
  { c = "Å", n = "Æ", l = " " }, { c = "Æ", n = "Ç", l = " " }, { c = "Ç", n = "È", l = " " }, { c = "È", n = "É", l = " " },
  { c = "É", n = "Ê", l = " " }, { c = "Ê", n = "Ë", l = " " }, { c = "Ë", n = "Ì", l = " " }, { c = "Ì", n = "Í", l = " " },
  { c = "Í", n = "Î", l = " " }, { c = "Î", n = "Ï", l = " " }, { c = "Ï", n = "Ð", l = " " }, { c = "Ð", n = "Ñ", l = " " },
  { c = "Ñ", n = "Ò", l = " " }, { c = "Ò", n = "Ó", l = " " }, { c = "Ó", n = "Ô", l = " " }, { c = "Ô", n = "Õ", l = " " },
  { c = "Õ", n = "Ö", l = " " }, { c = "Ö", n = "×", l = " " }, { c = "×", n = "Ø", l = " " }, { c = "Ø", n = "Ù", l = " " },
  { c = "Ù", n = "Ú", l = " " }, { c = "Ú", n = "Û", l = " " }, { c = "Û", n = "Ü", l = " " }, { c = "Ü", n = "Ý", l = " " },
  { c = "Ý", n = "Þ", l = " " }, { c = "Þ", n = "ß", l = " " }, { c = "ß", n = "à", l = " " }, { c = "à", n = "á", l = " " },
  { c = "á", n = "â", l = " " }, { c = "â", n = "ã", l = " " }, { c = "ã", n = "ä", l = " " }, { c = "ä", n = "å", l = " " },
  { c = "å", n = "æ", l = " " }, { c = "æ", n = "ç", l = " " }, { c = "ç", n = "è", l = " " }, { c = "è", n = "é", l = " " },
  { c = "é", n = "ê", l = " " }, { c = "ê", n = "ë", l = " " }, { c = "ë", n = "ì", l = " " }, { c = "ì", n = "í", l = " " },
  { c = "í", n = "î", l = " " }, { c = "î", n = "ï", l = " " }, { c = "ï", n = "ð", l = " " }, { c = "ð", n = "ñ", l = " " },
  { c = "ñ", n = "ò", l = " " }, { c = "ò", n = "ó", l = " " }, { c = "ó", n = "ô", l = " " }, { c = "ô", n = "õ", l = " " },
  { c = "õ", n = "ö", l = " " }, { c = "ö", n = "÷", l = " " }, { c = "÷", n = "ø", l = " " }, { c = "ø", n = "ù", l = " " },
  { c = "ù", n = "ú", l = " " }, { c = "ú", n = "û", l = " " }, { c = "û", n = "ü", l = " " }, { c = "ü", n = "ý", l = " " },
  { c = "ý", n = "þ", l = " " }, { c = "þ", n = "ÿ", l = " " }, { c = "ÿ", n = "Ā", l = " " }]

fn pick(found: List<Ch>): Ch = if len(found) == 0 then { c = "?", n = "?", l = "?" } else found[0]

// The character of s after its prefix p: l is "" at the end of s, "?" when it is not in the table.
fn nextOf(s: Text, p: Text): Ch =
  if s == p then { c = "", n = "", l = "" }
  else if (p + "A" <= s and s < p + "[") or (p + "a" <= s and s < p + "{")
    then pick(select r for r in letters() where p + r.c <= s and s < p + r.n)
  else pick(select r for r in others() where p + r.c <= s and s < p + r.n)

// True when t, from its prefix p on, is only ASCII letters.
fn lettersOnly(t: Text, p: Text): Bool = lettersStep(t, p, nextOf(t, p))

fn lettersStep(t: Text, p: Text, ch: Ch): Bool =
  if ch.l == "" then true
  else if ch.l == " " or ch.l == "?" then false
  else lettersOnly(t, p + ch.c)

fn hit(word: Text, w: Text): Int = if word == w then 1 else 0

// A word longer than 20 letters can never match, so it is shortened to a marker that is not
// letters only and therefore never equals the term.
fn cap(t: Text): Text = if len(t) > 20 then "#" else t

// What a stretch of the passage contributes. whole: no separator in it; first and last: the
// lowercase letters before its first and after its last separator; n: words strictly between
// those that match; stop: reading stopped at a character outside the table; p: the passage up
// to the end of the stretch.
//
// Reading one character per call would recurse 1,000 deep on the longest passage, which the
// interpreter does not survive, so the passage is split in halves: the depth is about log2 of
// its length.
type Seg = { whole: Bool, first: Text, last: Text, n: Int, stop: Bool, p: Text }

fn single(p: Text, ch: Ch): Seg =
  if ch.l == "?" then { whole = false, first = "", last = "", n = 0, stop = true, p = p }
  else if ch.l == " " then { whole = false, first = "", last = "", n = 0, stop = false, p = p + ch.c }
  else { whole = true, first = ch.l, last = ch.l, n = 0, stop = false, p = p + ch.c }

fn join(a: Seg, b: Seg, w: Text): Seg =
  if a.whole and b.whole then
    { whole = true, first = cap(a.first + b.first), last = cap(a.first + b.first), n = 0, stop = b.stop, p = b.p }
  else if a.whole then
    { whole = false, first = cap(a.first + b.first), last = b.last, n = b.n, stop = b.stop, p = b.p }
  else if b.whole then
    { whole = false, first = a.first, last = cap(a.last + b.first), n = a.n, stop = b.stop, p = b.p }
  else
    { whole = false, first = a.first, last = b.last, n = a.n + b.n + hit(cap(a.last + b.first), w), stop = b.stop, p = b.p }

// Reads k characters of s after its prefix p.
fn readSeg(s: Text, w: Text, p: Text, k: Int): Seg =
  if k <= 1 then single(p, nextOf(s, p))
  else readRest(s, w, readSeg(s, w, p, k / 2), k - k / 2)

fn readRest(s: Text, w: Text, a: Seg, k: Int): Seg =
  if a.stop then a else join(a, readSeg(s, w, a.p, k), w)

fn total(g: Seg, w: Text): Int =
  if g.whole then hit(g.first, w) else g.n + hit(g.first, w) + hit(g.last, w)

type Passage = Text where len(it) <= 1000
type Term = Text where len(it) >= 1 and len(it) <= 20 and lettersOnly(it, "")

query CountWords(passage: Passage, word: Term): Int permit public =
  if len(passage) == 0 then 0 else total(readSeg(passage, lower(word), "", len(passage)), lower(word))
