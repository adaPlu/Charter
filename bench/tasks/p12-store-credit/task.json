{
  "id": "p12-store-credit",
  "family": "F4",
  "validationOnly": false,
  "authoredBy": "AI-assisted pilot draft (2026-11-06). Reviewed and approved by the project owner (adaPlu) on 2026-11-09. Not independent: the reviewer worked on Charter's design and has seen solutions, so Phase 7's independence requirement is not met and the pilot report must say so.",
  "request": "An operator registers customers with zero store credit. The operator can grant 1–100000 whole cents to a customer. A customer can spend 1 or more cents from their own credit; an overdraft is InsufficientCredit and changes nothing. Registered customers can read only their own balance, and customers cannot issue grants.",
  "contract": {
    "rules": [
      {
        "name": "Register",
        "params": [
          [
            "name",
            "Text"
          ]
        ],
        "returns": "Id",
        "who": "operator only",
        "rejects": {}
      },
      {
        "name": "Grant",
        "params": [
          [
            "customer",
            "Id"
          ],
          [
            "cents",
            "Int"
          ]
        ],
        "returns": "Int: new balance",
        "who": "operator only",
        "rejects": {
          "NotFound": "customer missing",
          "ValidationError": "cents not 1..100000"
        }
      },
      {
        "name": "Spend",
        "params": [
          [
            "cents",
            "Int"
          ]
        ],
        "returns": "Int: new balance",
        "who": "registered caller",
        "rejects": {
          "ValidationError": "cents below 1",
          "InsufficientCredit": "balance below requested amount"
        }
      }
    ],
    "queries": [
      {
        "name": "Balance",
        "params": [],
        "returns": "Int",
        "who": "registered caller",
        "rejects": {}
      }
    ]
  },
  "visibleTests": [
    "grant and spend"
  ],
  "tests": [
    {
      "name": "grant and spend",
      "steps": [
        {
          "call": "rules/Register",
          "args": [
            "Ana"
          ],
          "system": true,
          "save": "ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Grant",
          "args": [
            "$ana",
            250
          ],
          "system": true,
          "expect": {
            "status": 200,
            "value": 250
          }
        },
        {
          "call": "rules/Spend",
          "args": [
            100
          ],
          "as": "$ana",
          "expect": {
            "status": 200,
            "value": 150
          }
        },
        {
          "call": "queries/Balance",
          "args": [],
          "as": "$ana",
          "expect": {
            "status": 200,
            "value": 150
          }
        }
      ]
    },
    {
      "name": "overdraft changes nothing",
      "steps": [
        {
          "call": "rules/Register",
          "args": [
            "Ana"
          ],
          "system": true,
          "save": "ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Grant",
          "args": [
            "$ana",
            10
          ],
          "system": true,
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Spend",
          "args": [
            11
          ],
          "as": "$ana",
          "expect": {
            "status": 409,
            "reason": "InsufficientCredit"
          }
        },
        {
          "call": "queries/Balance",
          "args": [],
          "as": "$ana",
          "expect": {
            "status": 200,
            "value": 10
          }
        },
        {
          "call": "rules/Spend",
          "args": [
            10
          ],
          "as": "$ana",
          "expect": {
            "status": 200,
            "value": 0
          }
        }
      ]
    },
    {
      "name": "isolate customers",
      "steps": [
        {
          "call": "rules/Register",
          "args": [
            "Ana"
          ],
          "system": true,
          "save": "ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Register",
          "args": [
            "Ben"
          ],
          "system": true,
          "save": "ben",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Grant",
          "args": [
            "$ana",
            100
          ],
          "system": true,
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Spend",
          "args": [
            10
          ],
          "as": "$ben",
          "expect": {
            "status": 409,
            "reason": "InsufficientCredit"
          }
        },
        {
          "call": "queries/Balance",
          "args": [],
          "as": "$ben",
          "expect": {
            "status": 200,
            "value": 0
          }
        },
        {
          "call": "queries/Balance",
          "args": [],
          "as": "$ana",
          "expect": {
            "status": 200,
            "value": 100
          }
        }
      ]
    },
    {
      "name": "authorization and validation",
      "steps": [
        {
          "call": "rules/Register",
          "args": [
            "Ana"
          ],
          "system": true,
          "save": "ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Grant",
          "args": [
            "$ana",
            1
          ],
          "as": "$ana",
          "expect": {
            "status": 403
          }
        },
        {
          "call": "rules/Grant",
          "args": [
            "$ana",
            0
          ],
          "system": true,
          "expect": {
            "status": 400
          }
        },
        {
          "call": "rules/Grant",
          "args": [
            "missing",
            5
          ],
          "system": true,
          "expect": {
            "status": 404
          }
        },
        {
          "call": "rules/Spend",
          "args": [
            0
          ],
          "as": "$ana",
          "expect": {
            "status": 400
          }
        },
        {
          "call": "rules/Spend",
          "args": [
            10
          ],
          "expect": {
            "status": 403
          }
        },
        {
          "call": "queries/Balance",
          "args": [],
          "expect": {
            "status": 404
          }
        }
      ]
    }
  ],
  "constants": {}
}
