{
  "id": "p21-release-versions",
  "family": "F6",
  "validationOnly": false,
  "authoredBy": "AI-assisted pilot draft (2026-11-09), written without reading the new language's design. Reviewed and approved by the project owner (adaPlu) on 2026-11-09. Not independent: the reviewer worked on Charter's design and has seen solutions, so Phase 7's independence requirement is not met and the pilot report must say so.",
  "request": "A public release tool compares two software version numbers and says whether the first is older than, the same as, or newer than the second. A version is 1 to 4 parts separated by single dots, and each part is 1 to 5 ASCII digits 0–9; nothing else is allowed, not even spaces or signs. Parts are compared as whole numbers from the left, so 1.10 is newer than 1.9, and leading zeros do not matter (007 equals 7). A version with fewer parts counts as if extra 0 parts were added at its end, so 1.2 and 1.2.0 are the same. If either version is not valid, the comparison is a ValidationError.",
  "contract": {
    "rules": [],
    "queries": [
      {
        "name": "CompareVersions",
        "params": [
          [
            "first",
            "Text"
          ],
          [
            "second",
            "Text"
          ]
        ],
        "returns": "Text: \"older\", \"same\" or \"newer\", describing first compared with second",
        "who": "anyone",
        "rejects": {
          "ValidationError": "either version is not 1–4 parts of 1–5 ASCII digits separated by single dots"
        }
      }
    ]
  },
  "visibleTests": [
    "basic comparisons"
  ],
  "tests": [
    {
      "name": "basic comparisons",
      "steps": [
        {
          "call": "queries/CompareVersions",
          "args": [
            "1.2.3",
            "1.2.4"
          ],
          "expect": {
            "status": 200,
            "value": "older"
          }
        },
        {
          "call": "queries/CompareVersions",
          "args": [
            "2.0",
            "1.9.9"
          ],
          "expect": {
            "status": 200,
            "value": "newer"
          }
        },
        {
          "call": "queries/CompareVersions",
          "args": [
            "1.2.3",
            "1.2.3"
          ],
          "expect": {
            "status": 200,
            "value": "same"
          }
        }
      ]
    },
    {
      "name": "numbers not text",
      "steps": [
        {
          "call": "queries/CompareVersions",
          "args": [
            "1.10",
            "1.9"
          ],
          "expect": {
            "status": 200,
            "value": "newer"
          }
        },
        {
          "call": "queries/CompareVersions",
          "args": [
            "1.9.0",
            "1.10"
          ],
          "expect": {
            "status": 200,
            "value": "older"
          }
        },
        {
          "call": "queries/CompareVersions",
          "args": [
            "10",
            "9"
          ],
          "expect": {
            "status": 200,
            "value": "newer"
          }
        },
        {
          "call": "queries/CompareVersions",
          "args": [
            "2",
            "10"
          ],
          "expect": {
            "status": 200,
            "value": "older"
          }
        },
        {
          "call": "queries/CompareVersions",
          "args": [
            "007.1",
            "7.01"
          ],
          "expect": {
            "status": 200,
            "value": "same"
          }
        }
      ]
    },
    {
      "name": "missing parts and limits",
      "steps": [
        {
          "call": "queries/CompareVersions",
          "args": [
            "1.2",
            "1.2.0.0"
          ],
          "expect": {
            "status": 200,
            "value": "same"
          }
        },
        {
          "call": "queries/CompareVersions",
          "args": [
            "1.2",
            "1.2.0.1"
          ],
          "expect": {
            "status": 200,
            "value": "older"
          }
        },
        {
          "call": "queries/CompareVersions",
          "args": [
            "3",
            "2.99999"
          ],
          "expect": {
            "status": 200,
            "value": "newer"
          }
        },
        {
          "call": "queries/CompareVersions",
          "args": [
            "0",
            "0.0.0.0"
          ],
          "expect": {
            "status": 200,
            "value": "same"
          }
        },
        {
          "call": "queries/CompareVersions",
          "args": [
            "00000",
            "0"
          ],
          "expect": {
            "status": 200,
            "value": "same"
          }
        },
        {
          "call": "queries/CompareVersions",
          "args": [
            "99999.99999.99999.99999",
            "99999.99999.99999.99998"
          ],
          "expect": {
            "status": 200,
            "value": "newer"
          }
        }
      ]
    },
    {
      "name": "invalid versions",
      "steps": [
        {
          "call": "queries/CompareVersions",
          "args": [
            "",
            "1"
          ],
          "expect": {
            "status": 400
          }
        },
        {
          "call": "queries/CompareVersions",
          "args": [
            "1",
            "1..2"
          ],
          "expect": {
            "status": 400
          }
        },
        {
          "call": "queries/CompareVersions",
          "args": [
            "1.2.3.4.5",
            "1"
          ],
          "expect": {
            "status": 400
          }
        },
        {
          "call": "queries/CompareVersions",
          "args": [
            "1",
            "123456"
          ],
          "expect": {
            "status": 400
          }
        },
        {
          "call": "queries/CompareVersions",
          "args": [
            "1.2a",
            "1"
          ],
          "expect": {
            "status": 400
          }
        },
        {
          "call": "queries/CompareVersions",
          "args": [
            ".1",
            "1"
          ],
          "expect": {
            "status": 400
          }
        },
        {
          "call": "queries/CompareVersions",
          "args": [
            "1",
            "1.2."
          ],
          "expect": {
            "status": 400
          }
        },
        {
          "call": "queries/CompareVersions",
          "args": [
            " 1.2",
            "1"
          ],
          "expect": {
            "status": 400
          }
        },
        {
          "call": "queries/CompareVersions",
          "args": [
            "-1",
            "1"
          ],
          "expect": {
            "status": 400
          }
        }
      ]
    }
  ],
  "constants": {}
}
