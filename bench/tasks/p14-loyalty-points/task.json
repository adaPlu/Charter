{
  "id": "p14-loyalty-points",
  "family": "F4",
  "validationOnly": false,
  "authoredBy": "AI-assisted pilot draft (2026-11-06), not independently written or reviewed; independent task-author/reviewer approval required before scientific use",
  "request": "An operator registers customers with zero reward points. A customer may earn 1–1000 integer points at a time, transfer 1 or more to another registered customer, and redeem 1 or more. Transfers to oneself are SelfTransfer. Transfers and redemptions cannot overdraw a balance; failure changes neither balance. A customer sees only their own points.",
  "contract": {
    "rules": [
      {
        "name": "Register",
        "params": [
          [
            "name",
            "Text"
          ]
        ],
        "returns": "Id",
        "who": "operator only",
        "rejects": {}
      },
      {
        "name": "Earn",
        "params": [
          [
            "points",
            "Int"
          ]
        ],
        "returns": "Int: balance",
        "who": "registered caller",
        "rejects": {
          "ValidationError": "points not 1..1000"
        }
      },
      {
        "name": "Transfer",
        "params": [
          [
            "to",
            "Id"
          ],
          [
            "points",
            "Int"
          ]
        ],
        "returns": "Int: sender balance",
        "who": "registered caller",
        "rejects": {
          "NotFound": "recipient missing",
          "ValidationError": "points below 1",
          "SelfTransfer": "same caller and recipient",
          "InsufficientPoints": "sender lacks points"
        }
      },
      {
        "name": "Redeem",
        "params": [
          [
            "points",
            "Int"
          ]
        ],
        "returns": "Int: balance",
        "who": "registered caller",
        "rejects": {
          "ValidationError": "points below 1",
          "InsufficientPoints": "balance too small"
        }
      }
    ],
    "queries": [
      {
        "name": "Points",
        "params": [],
        "returns": "Int",
        "who": "registered caller",
        "rejects": {}
      }
    ]
  },
  "visibleTests": [
    "earn send and redeem"
  ],
  "tests": [
    {
      "name": "earn send and redeem",
      "steps": [
        {
          "call": "rules/Register",
          "args": [
            "Ana"
          ],
          "system": true,
          "save": "ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Register",
          "args": [
            "Ben"
          ],
          "system": true,
          "save": "ben",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Earn",
          "args": [
            50
          ],
          "as": "$ana",
          "expect": {
            "status": 200,
            "value": 50
          }
        },
        {
          "call": "rules/Transfer",
          "args": [
            "$ben",
            20
          ],
          "as": "$ana",
          "expect": {
            "status": 200,
            "value": 30
          }
        },
        {
          "call": "rules/Redeem",
          "args": [
            5
          ],
          "as": "$ben",
          "expect": {
            "status": 200,
            "value": 15
          }
        },
        {
          "call": "queries/Points",
          "args": [],
          "as": "$ana",
          "expect": {
            "status": 200,
            "value": 30
          }
        }
      ]
    },
    {
      "name": "no overdraw",
      "steps": [
        {
          "call": "rules/Register",
          "args": [
            "Ana"
          ],
          "system": true,
          "save": "ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Register",
          "args": [
            "Ben"
          ],
          "system": true,
          "save": "ben",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Earn",
          "args": [
            5
          ],
          "as": "$ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Transfer",
          "args": [
            "$ben",
            6
          ],
          "as": "$ana",
          "expect": {
            "status": 409,
            "reason": "InsufficientPoints"
          }
        },
        {
          "call": "rules/Redeem",
          "args": [
            6
          ],
          "as": "$ana",
          "expect": {
            "status": 409,
            "reason": "InsufficientPoints"
          }
        },
        {
          "call": "queries/Points",
          "args": [],
          "as": "$ana",
          "expect": {
            "status": 200,
            "value": 5
          }
        },
        {
          "call": "queries/Points",
          "args": [],
          "as": "$ben",
          "expect": {
            "status": 200,
            "value": 0
          }
        }
      ]
    },
    {
      "name": "self and unknown receiver",
      "steps": [
        {
          "call": "rules/Register",
          "args": [
            "Ana"
          ],
          "system": true,
          "save": "ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Earn",
          "args": [
            10
          ],
          "as": "$ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Transfer",
          "args": [
            "$ana",
            1
          ],
          "as": "$ana",
          "expect": {
            "status": 409,
            "reason": "SelfTransfer"
          }
        },
        {
          "call": "rules/Transfer",
          "args": [
            "missing",
            1
          ],
          "as": "$ana",
          "expect": {
            "status": 404
          }
        },
        {
          "call": "queries/Points",
          "args": [],
          "as": "$ana",
          "expect": {
            "status": 200,
            "value": 10
          }
        }
      ]
    },
    {
      "name": "bad amounts and caller",
      "steps": [
        {
          "call": "rules/Register",
          "args": [
            "Ana"
          ],
          "system": true,
          "save": "ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Earn",
          "args": [
            0
          ],
          "as": "$ana",
          "expect": {
            "status": 400
          }
        },
        {
          "call": "rules/Earn",
          "args": [
            1001
          ],
          "as": "$ana",
          "expect": {
            "status": 400
          }
        },
        {
          "call": "rules/Redeem",
          "args": [
            0
          ],
          "as": "$ana",
          "expect": {
            "status": 400
          }
        },
        {
          "call": "rules/Earn",
          "args": [
            1
          ],
          "expect": {
            "status": 403
          }
        },
        {
          "call": "queries/Points",
          "args": [],
          "expect": {
            "status": 404
          }
        }
      ]
    }
  ],
  "constants": {}
}
