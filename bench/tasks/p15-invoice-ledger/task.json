{
  "id": "p15-invoice-ledger",
  "family": "F4",
  "validationOnly": false,
  "authoredBy": "AI-assisted pilot draft (2026-11-06), not independently written or reviewed; independent task-author/reviewer approval required before scientific use",
  "request": "An operator registers customers and creates invoices of 1–1000000 cents for one customer. That customer may pay a positive whole-cent amount no greater than the remaining balance. Only the operator may refund a positive amount no greater than what has already been paid; a refund increases the outstanding balance. Failed calls do not change amounts. Only the invoice customer can see its remaining balance.",
  "contract": {
    "rules": [
      {
        "name": "Register",
        "params": [
          [
            "name",
            "Text"
          ]
        ],
        "returns": "Id",
        "who": "operator only",
        "rejects": {}
      },
      {
        "name": "CreateInvoice",
        "params": [
          [
            "customer",
            "Id"
          ],
          [
            "totalCents",
            "Int"
          ]
        ],
        "returns": "Id",
        "who": "operator only",
        "rejects": {
          "NotFound": "customer missing",
          "ValidationError": "total not 1..1000000"
        }
      },
      {
        "name": "PayInvoice",
        "params": [
          [
            "invoice",
            "Id"
          ],
          [
            "cents",
            "Int"
          ]
        ],
        "returns": "Int: remaining balance",
        "who": "invoice customer",
        "rejects": {
          "NotFound": "invoice missing",
          "Denied": "not customer",
          "ValidationError": "cents below 1",
          "Overpayment": "exceeds remaining"
        }
      },
      {
        "name": "Refund",
        "params": [
          [
            "invoice",
            "Id"
          ],
          [
            "cents",
            "Int"
          ]
        ],
        "returns": "Int: remaining balance",
        "who": "operator only",
        "rejects": {
          "NotFound": "invoice missing",
          "ValidationError": "cents below 1",
          "ExcessRefund": "exceeds paid amount"
        }
      }
    ],
    "queries": [
      {
        "name": "Outstanding",
        "params": [
          [
            "invoice",
            "Id"
          ]
        ],
        "returns": "Int",
        "who": "invoice customer",
        "rejects": {
          "NotFound": "invoice missing",
          "Denied": "not customer"
        }
      }
    ]
  },
  "visibleTests": [
    "partial then complete"
  ],
  "tests": [
    {
      "name": "partial then complete",
      "steps": [
        {
          "call": "rules/Register",
          "args": [
            "Ana"
          ],
          "system": true,
          "save": "ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/CreateInvoice",
          "args": [
            "$ana",
            1000
          ],
          "system": true,
          "save": "inv",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/PayInvoice",
          "args": [
            "$inv",
            400
          ],
          "as": "$ana",
          "expect": {
            "status": 200,
            "value": 600
          }
        },
        {
          "call": "rules/PayInvoice",
          "args": [
            "$inv",
            600
          ],
          "as": "$ana",
          "expect": {
            "status": 200,
            "value": 0
          }
        },
        {
          "call": "queries/Outstanding",
          "args": [
            "$inv"
          ],
          "as": "$ana",
          "expect": {
            "status": 200,
            "value": 0
          }
        }
      ]
    },
    {
      "name": "partial refund",
      "steps": [
        {
          "call": "rules/Register",
          "args": [
            "Ana"
          ],
          "system": true,
          "save": "ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/CreateInvoice",
          "args": [
            "$ana",
            100
          ],
          "system": true,
          "save": "inv",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/PayInvoice",
          "args": [
            "$inv",
            60
          ],
          "as": "$ana",
          "expect": {
            "status": 200,
            "value": 40
          }
        },
        {
          "call": "rules/Refund",
          "args": [
            "$inv",
            40
          ],
          "system": true,
          "expect": {
            "status": 200,
            "value": 80
          }
        },
        {
          "call": "rules/Refund",
          "args": [
            "$inv",
            21
          ],
          "system": true,
          "expect": {
            "status": 409,
            "reason": "ExcessRefund"
          }
        },
        {
          "call": "queries/Outstanding",
          "args": [
            "$inv"
          ],
          "as": "$ana",
          "expect": {
            "status": 200,
            "value": 80
          }
        }
      ]
    },
    {
      "name": "overpayment and privacy",
      "steps": [
        {
          "call": "rules/Register",
          "args": [
            "Ana"
          ],
          "system": true,
          "save": "ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Register",
          "args": [
            "Ben"
          ],
          "system": true,
          "save": "ben",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/CreateInvoice",
          "args": [
            "$ana",
            50
          ],
          "system": true,
          "save": "inv",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/PayInvoice",
          "args": [
            "$inv",
            51
          ],
          "as": "$ana",
          "expect": {
            "status": 409,
            "reason": "Overpayment"
          }
        },
        {
          "call": "rules/PayInvoice",
          "args": [
            "$inv",
            1
          ],
          "as": "$ben",
          "expect": {
            "status": 403
          }
        },
        {
          "call": "queries/Outstanding",
          "args": [
            "$inv"
          ],
          "as": "$ben",
          "expect": {
            "status": 404,
            "reason": "Denied"
          }
        },
        {
          "call": "queries/Outstanding",
          "args": [
            "$inv"
          ],
          "as": "$ana",
          "expect": {
            "status": 200,
            "value": 50
          }
        }
      ]
    },
    {
      "name": "bad calls",
      "steps": [
        {
          "call": "rules/Register",
          "args": [
            "Ana"
          ],
          "system": true,
          "save": "ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/CreateInvoice",
          "args": [
            "$ana",
            0
          ],
          "system": true,
          "expect": {
            "status": 400
          }
        },
        {
          "call": "rules/CreateInvoice",
          "args": [
            "missing",
            50
          ],
          "system": true,
          "expect": {
            "status": 404
          }
        },
        {
          "call": "rules/CreateInvoice",
          "args": [
            "$ana",
            50
          ],
          "as": "$ana",
          "expect": {
            "status": 403
          }
        },
        {
          "call": "rules/CreateInvoice",
          "args": [
            "$ana",
            50
          ],
          "system": true,
          "save": "inv",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/PayInvoice",
          "args": [
            "$inv",
            10
          ],
          "as": "$ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Refund",
          "args": [
            "$inv",
            1
          ],
          "as": "$ana",
          "expect": {
            "status": 403
          }
        },
        {
          "call": "rules/PayInvoice",
          "args": [
            "$inv",
            0
          ],
          "as": "$ana",
          "expect": {
            "status": 400
          }
        }
      ]
    }
  ],
  "constants": {}
}
