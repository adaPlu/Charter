{
  "id": "p16-leave-approvals",
  "family": "F5",
  "validationOnly": false,
  "authoredBy": "AI-assisted pilot draft (2026-11-06), not independently written or reviewed; independent task-author/reviewer approval required before scientific use",
  "request": "An operator registers workers. A worker requests 1–14 days of leave with a nonblank reason of at most 200 characters. Requests start pending. Only the operator may approve or reject a pending request. The worker may withdraw a pending request. After approval, rejection or withdrawal no more changes are allowed. Workers see only their own status.",
  "contract": {
    "rules": [
      {
        "name": "Register",
        "params": [
          [
            "name",
            "Text"
          ]
        ],
        "returns": "Id",
        "who": "operator only",
        "rejects": {}
      },
      {
        "name": "RequestLeave",
        "params": [
          [
            "days",
            "Int"
          ],
          [
            "reason",
            "Text"
          ]
        ],
        "returns": "Id",
        "who": "registered caller",
        "rejects": {
          "ValidationError": "days not 1..14 or reason blank/too long"
        }
      },
      {
        "name": "Approve",
        "params": [
          [
            "request",
            "Id"
          ]
        ],
        "returns": "nothing",
        "who": "operator only",
        "rejects": {
          "NotFound": "request missing",
          "WrongState": "not pending"
        }
      },
      {
        "name": "RejectLeave",
        "params": [
          [
            "request",
            "Id"
          ]
        ],
        "returns": "nothing",
        "who": "operator only",
        "rejects": {
          "NotFound": "request missing",
          "WrongState": "not pending"
        }
      },
      {
        "name": "Withdraw",
        "params": [
          [
            "request",
            "Id"
          ]
        ],
        "returns": "nothing",
        "who": "request owner",
        "rejects": {
          "NotFound": "request missing",
          "Denied": "not owner",
          "WrongState": "not pending"
        }
      }
    ],
    "queries": [
      {
        "name": "LeaveStatus",
        "params": [
          [
            "request",
            "Id"
          ]
        ],
        "returns": "Text: pending, approved, rejected or withdrawn",
        "who": "request owner",
        "rejects": {
          "NotFound": "request missing",
          "Denied": "not owner"
        }
      }
    ]
  },
  "visibleTests": [
    "approve pending"
  ],
  "tests": [
    {
      "name": "approve pending",
      "steps": [
        {
          "call": "rules/Register",
          "args": [
            "Ana"
          ],
          "system": true,
          "save": "ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/RequestLeave",
          "args": [
            3,
            "Trip"
          ],
          "as": "$ana",
          "save": "req",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "queries/LeaveStatus",
          "args": [
            "$req"
          ],
          "as": "$ana",
          "expect": {
            "status": 200,
            "value": "pending"
          }
        },
        {
          "call": "rules/Approve",
          "args": [
            "$req"
          ],
          "system": true,
          "expect": {
            "status": 200
          }
        },
        {
          "call": "queries/LeaveStatus",
          "args": [
            "$req"
          ],
          "as": "$ana",
          "expect": {
            "status": 200,
            "value": "approved"
          }
        }
      ]
    },
    {
      "name": "withdraw then cannot approve",
      "steps": [
        {
          "call": "rules/Register",
          "args": [
            "Ana"
          ],
          "system": true,
          "save": "ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/RequestLeave",
          "args": [
            1,
            "Errand"
          ],
          "as": "$ana",
          "save": "req",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Withdraw",
          "args": [
            "$req"
          ],
          "as": "$ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Approve",
          "args": [
            "$req"
          ],
          "system": true,
          "expect": {
            "status": 409,
            "reason": "WrongState"
          }
        },
        {
          "call": "queries/LeaveStatus",
          "args": [
            "$req"
          ],
          "as": "$ana",
          "expect": {
            "status": 200,
            "value": "withdrawn"
          }
        }
      ]
    },
    {
      "name": "reject is final",
      "steps": [
        {
          "call": "rules/Register",
          "args": [
            "Ana"
          ],
          "system": true,
          "save": "ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/RequestLeave",
          "args": [
            2,
            "Family"
          ],
          "as": "$ana",
          "save": "req",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/RejectLeave",
          "args": [
            "$req"
          ],
          "system": true,
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Approve",
          "args": [
            "$req"
          ],
          "system": true,
          "expect": {
            "status": 409,
            "reason": "WrongState"
          }
        },
        {
          "call": "rules/Withdraw",
          "args": [
            "$req"
          ],
          "as": "$ana",
          "expect": {
            "status": 409,
            "reason": "WrongState"
          }
        },
        {
          "call": "queries/LeaveStatus",
          "args": [
            "$req"
          ],
          "as": "$ana",
          "expect": {
            "status": 200,
            "value": "rejected"
          }
        }
      ]
    },
    {
      "name": "permissions and validation",
      "steps": [
        {
          "call": "rules/Register",
          "args": [
            "Ana"
          ],
          "system": true,
          "save": "ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Register",
          "args": [
            "Ben"
          ],
          "system": true,
          "save": "ben",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/RequestLeave",
          "args": [
            0,
            "Trip"
          ],
          "as": "$ana",
          "expect": {
            "status": 400
          }
        },
        {
          "call": "rules/RequestLeave",
          "args": [
            1,
            " "
          ],
          "as": "$ana",
          "expect": {
            "status": 400
          }
        },
        {
          "call": "rules/RequestLeave",
          "args": [
            1,
            "Trip"
          ],
          "as": "$ana",
          "save": "req",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Approve",
          "args": [
            "$req"
          ],
          "as": "$ben",
          "expect": {
            "status": 403
          }
        },
        {
          "call": "rules/Withdraw",
          "args": [
            "$req"
          ],
          "as": "$ben",
          "expect": {
            "status": 403
          }
        },
        {
          "call": "queries/LeaveStatus",
          "args": [
            "$req"
          ],
          "as": "$ben",
          "expect": {
            "status": 404,
            "reason": "Denied"
          }
        }
      ]
    }
  ],
  "constants": {}
}
