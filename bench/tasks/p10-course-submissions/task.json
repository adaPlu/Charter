{
  "id": "p10-course-submissions",
  "family": "F3",
  "validationOnly": false,
  "authoredBy": "AI-assisted pilot draft (2026-11-06), not independently written or reviewed; independent task-author/reviewer approval required before scientific use",
  "request": "An operator registers students and creates classes with nonblank codes. Students can enroll in any existing class once. An enrolled student may submit exactly one nonblank answer, up to 200 characters, per class. Students can read only their own submitted answer; an enrolled student with no answer gets NotFound. Only the operator can see the total number of submissions.",
  "contract": {
    "rules": [
      {
        "name": "Register",
        "params": [
          [
            "name",
            "Text"
          ]
        ],
        "returns": "Id",
        "who": "operator only",
        "rejects": {}
      },
      {
        "name": "CreateClass",
        "params": [
          [
            "code",
            "Text"
          ]
        ],
        "returns": "Id",
        "who": "operator only",
        "rejects": {
          "ValidationError": "blank code"
        }
      },
      {
        "name": "Enroll",
        "params": [
          [
            "course",
            "Id"
          ]
        ],
        "returns": "nothing",
        "who": "registered caller",
        "rejects": {
          "NotFound": "class missing",
          "AlreadyEnrolled": "already enrolled"
        }
      },
      {
        "name": "Submit",
        "params": [
          [
            "course",
            "Id"
          ],
          [
            "answer",
            "Text"
          ]
        ],
        "returns": "nothing",
        "who": "enrolled student",
        "rejects": {
          "NotFound": "class missing",
          "Denied": "not enrolled",
          "ValidationError": "answer blank or too long",
          "AlreadySubmitted": "already submitted"
        }
      }
    ],
    "queries": [
      {
        "name": "MyAnswer",
        "params": [
          [
            "course",
            "Id"
          ]
        ],
        "returns": "Text",
        "who": "enrolled student",
        "rejects": {
          "NotFound": "no class or submission",
          "Denied": "not enrolled"
        }
      },
      {
        "name": "SubmissionCount",
        "params": [
          [
            "course",
            "Id"
          ]
        ],
        "returns": "Int",
        "who": "operator only",
        "rejects": {
          "NotFound": "class missing"
        }
      }
    ]
  },
  "visibleTests": [
    "enroll and submit"
  ],
  "tests": [
    {
      "name": "enroll and submit",
      "steps": [
        {
          "call": "rules/Register",
          "args": [
            "Ana"
          ],
          "system": true,
          "save": "ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/CreateClass",
          "args": [
            "CS101"
          ],
          "system": true,
          "save": "course",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Enroll",
          "args": [
            "$course"
          ],
          "as": "$ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Submit",
          "args": [
            "$course",
            "My answer"
          ],
          "as": "$ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "queries/MyAnswer",
          "args": [
            "$course"
          ],
          "as": "$ana",
          "expect": {
            "status": 200,
            "value": "My answer"
          }
        },
        {
          "call": "queries/SubmissionCount",
          "args": [
            "$course"
          ],
          "system": true,
          "expect": {
            "status": 200,
            "value": 1
          }
        }
      ]
    },
    {
      "name": "enrollment restrictions",
      "steps": [
        {
          "call": "rules/Register",
          "args": [
            "Ana"
          ],
          "system": true,
          "save": "ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/CreateClass",
          "args": [
            "CS101"
          ],
          "system": true,
          "save": "course",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Submit",
          "args": [
            "$course",
            "No"
          ],
          "as": "$ana",
          "expect": {
            "status": 403
          }
        },
        {
          "call": "queries/MyAnswer",
          "args": [
            "$course"
          ],
          "as": "$ana",
          "expect": {
            "status": 404
          }
        },
        {
          "call": "rules/Enroll",
          "args": [
            "$course"
          ],
          "as": "$ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Enroll",
          "args": [
            "$course"
          ],
          "as": "$ana",
          "expect": {
            "status": 409,
            "reason": "AlreadyEnrolled"
          }
        },
        {
          "call": "queries/MyAnswer",
          "args": [
            "$course"
          ],
          "as": "$ana",
          "expect": {
            "status": 404
          }
        }
      ]
    },
    {
      "name": "one answer each",
      "steps": [
        {
          "call": "rules/Register",
          "args": [
            "Ana"
          ],
          "system": true,
          "save": "ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Register",
          "args": [
            "Ben"
          ],
          "system": true,
          "save": "ben",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/CreateClass",
          "args": [
            "CS101"
          ],
          "system": true,
          "save": "course",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Enroll",
          "args": [
            "$course"
          ],
          "as": "$ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Enroll",
          "args": [
            "$course"
          ],
          "as": "$ben",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Submit",
          "args": [
            "$course",
            "One"
          ],
          "as": "$ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Submit",
          "args": [
            "$course",
            "Two"
          ],
          "as": "$ana",
          "expect": {
            "status": 409,
            "reason": "AlreadySubmitted"
          }
        },
        {
          "call": "rules/Submit",
          "args": [
            "$course",
            "Different"
          ],
          "as": "$ben",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "queries/SubmissionCount",
          "args": [
            "$course"
          ],
          "system": true,
          "expect": {
            "status": 200,
            "value": 2
          }
        }
      ]
    },
    {
      "name": "operator and validation",
      "steps": [
        {
          "call": "rules/Register",
          "args": [
            "Ana"
          ],
          "system": true,
          "save": "ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/CreateClass",
          "args": [
            "X"
          ],
          "as": "$ana",
          "expect": {
            "status": 403
          }
        },
        {
          "call": "rules/CreateClass",
          "args": [
            " "
          ],
          "system": true,
          "expect": {
            "status": 400
          }
        },
        {
          "call": "rules/CreateClass",
          "args": [
            "X"
          ],
          "system": true,
          "save": "course",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Enroll",
          "args": [
            "$course"
          ],
          "as": "$ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Submit",
          "args": [
            "$course",
            " "
          ],
          "as": "$ana",
          "expect": {
            "status": 400
          }
        },
        {
          "call": "queries/SubmissionCount",
          "args": [
            "$course"
          ],
          "as": "$ana",
          "expect": {
            "status": 404,
            "reason": "Denied"
          }
        }
      ]
    }
  ],
  "constants": {}
}
