{
  "id": "p11-collaborative-lists",
  "family": "F3",
  "validationOnly": false,
  "authoredBy": "AI-assisted pilot draft (2026-11-06), not independently written or reviewed; independent task-author/reviewer approval required before scientific use",
  "request": "An operator registers people. A person creates and owns a private shopping list. Only the owner may invite other registered people. The owner is a member of their own list. Members can add items named with 1–60 nonblank characters. Only the item author or list owner may remove an item. Only members can see that list's items sorted by name then id.",
  "contract": {
    "rules": [
      {
        "name": "Register",
        "params": [
          [
            "name",
            "Text"
          ]
        ],
        "returns": "Id",
        "who": "operator only",
        "rejects": {}
      },
      {
        "name": "CreateList",
        "params": [
          [
            "name",
            "Text"
          ]
        ],
        "returns": "Id",
        "who": "registered caller",
        "rejects": {
          "ValidationError": "blank name"
        }
      },
      {
        "name": "Invite",
        "params": [
          [
            "list",
            "Id"
          ],
          [
            "person",
            "Id"
          ]
        ],
        "returns": "nothing",
        "who": "list owner",
        "rejects": {
          "NotFound": "list or person missing",
          "Denied": "not owner"
        }
      },
      {
        "name": "AddItem",
        "params": [
          [
            "list",
            "Id"
          ],
          [
            "name",
            "Text"
          ]
        ],
        "returns": "Id",
        "who": "list member",
        "rejects": {
          "NotFound": "list missing",
          "Denied": "not member",
          "ValidationError": "blank or long item name"
        }
      },
      {
        "name": "RemoveItem",
        "params": [
          [
            "item",
            "Id"
          ]
        ],
        "returns": "nothing",
        "who": "item author or list owner",
        "rejects": {
          "NotFound": "item missing",
          "Denied": "not authorized"
        }
      }
    ],
    "queries": [
      {
        "name": "ListItems",
        "params": [
          [
            "list",
            "Id"
          ]
        ],
        "returns": "List of { id: Id, name: Text }, sorted name then id",
        "who": "list member",
        "rejects": {
          "NotFound": "list missing",
          "Denied": "not member"
        }
      }
    ]
  },
  "visibleTests": [
    "shared list"
  ],
  "tests": [
    {
      "name": "shared list",
      "steps": [
        {
          "call": "rules/Register",
          "args": [
            "Ana"
          ],
          "system": true,
          "save": "ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Register",
          "args": [
            "Ben"
          ],
          "system": true,
          "save": "ben",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/CreateList",
          "args": [
            "Shop"
          ],
          "as": "$ana",
          "save": "list",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Invite",
          "args": [
            "$list",
            "$ben"
          ],
          "as": "$ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/AddItem",
          "args": [
            "$list",
            "Milk"
          ],
          "as": "$ben",
          "save": "item",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "queries/ListItems",
          "args": [
            "$list"
          ],
          "as": "$ana",
          "expect": {
            "status": 200,
            "value": [
              {
                "id": "$item",
                "name": "Milk"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "outsider cannot read",
      "steps": [
        {
          "call": "rules/Register",
          "args": [
            "Ana"
          ],
          "system": true,
          "save": "ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Register",
          "args": [
            "Ben"
          ],
          "system": true,
          "save": "ben",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/CreateList",
          "args": [
            "Shop"
          ],
          "as": "$ana",
          "save": "list",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "queries/ListItems",
          "args": [
            "$list"
          ],
          "as": "$ben",
          "expect": {
            "status": 404,
            "reason": "Denied"
          }
        },
        {
          "call": "rules/AddItem",
          "args": [
            "$list",
            "No"
          ],
          "as": "$ben",
          "expect": {
            "status": 403
          }
        },
        {
          "call": "rules/Invite",
          "args": [
            "$list",
            "$ben"
          ],
          "as": "$ben",
          "expect": {
            "status": 403
          }
        }
      ]
    },
    {
      "name": "remove permissions",
      "steps": [
        {
          "call": "rules/Register",
          "args": [
            "Ana"
          ],
          "system": true,
          "save": "ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Register",
          "args": [
            "Ben"
          ],
          "system": true,
          "save": "ben",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Register",
          "args": [
            "Cal"
          ],
          "system": true,
          "save": "cal",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/CreateList",
          "args": [
            "Shop"
          ],
          "as": "$ana",
          "save": "list",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Invite",
          "args": [
            "$list",
            "$ben"
          ],
          "as": "$ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Invite",
          "args": [
            "$list",
            "$cal"
          ],
          "as": "$ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/AddItem",
          "args": [
            "$list",
            "Eggs"
          ],
          "as": "$ben",
          "save": "item",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/RemoveItem",
          "args": [
            "$item"
          ],
          "as": "$cal",
          "expect": {
            "status": 403
          }
        },
        {
          "call": "rules/RemoveItem",
          "args": [
            "$item"
          ],
          "as": "$ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "queries/ListItems",
          "args": [
            "$list"
          ],
          "as": "$ben",
          "expect": {
            "status": 200,
            "value": []
          }
        }
      ]
    },
    {
      "name": "validation and missing",
      "steps": [
        {
          "call": "rules/Register",
          "args": [
            "Ana"
          ],
          "system": true,
          "save": "ana",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/CreateList",
          "args": [
            " "
          ],
          "as": "$ana",
          "expect": {
            "status": 400
          }
        },
        {
          "call": "rules/CreateList",
          "args": [
            "Shop"
          ],
          "as": "$ana",
          "save": "list",
          "expect": {
            "status": 200
          }
        },
        {
          "call": "rules/Invite",
          "args": [
            "$list",
            "missing"
          ],
          "as": "$ana",
          "expect": {
            "status": 404
          }
        },
        {
          "call": "rules/AddItem",
          "args": [
            "$list",
            " "
          ],
          "as": "$ana",
          "expect": {
            "status": 400
          }
        },
        {
          "call": "rules/RemoveItem",
          "args": [
            "missing"
          ],
          "as": "$ana",
          "expect": {
            "status": 404
          }
        }
      ]
    }
  ],
  "constants": {}
}
