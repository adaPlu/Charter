{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "bench/harness/**/*.ts",
    "bench/scaffold-ts/runtime.ts",
    "bench/scaffold-ts/server.ts"
  ]
}
